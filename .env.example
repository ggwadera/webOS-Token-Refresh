# Set these to your Linux host's reserved LAN address and your trusted LAN subnet.
LAN_BIND_IP=192.168.1.20
LAN_CIDR=192.168.1.0/24

# Create a local DNS/hosts entry for this name pointing to LAN_BIND_IP.
APP_HOST=webos-refresh.home.arpa

# Use a unique username and a long password. Store only the Caddy bcrypt hash here.
CADDY_USER=webos-admin
CADDY_PASSWORD_HASH='replace-with-output-of-caddy-hash-password'

# Minimum accepted interval is 300 seconds; default is one day.
SCRIPT_INTERVAL=86400
